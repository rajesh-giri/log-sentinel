// Prisma schema for log-sentinel
// Models the normalized data we store after parsing an uploaded log file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  uploads      Upload[]
}

enum UploadStatus {
  PROCESSING
  COMPLETE
  FAILED
}

model Upload {
  id           String       @id @default(cuid())
  filename     String
  status       UploadStatus @default(PROCESSING)
  errorMessage String?
  rawSizeBytes Int
  rawContent   String?
  lineCount    Int          @default(0)
  parsedCount  Int          @default(0)
  narrativeSummary String?
  createdAt    DateTime     @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  events    LogEvent[]
  anomalies Anomaly[]
}

model LogEvent {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime
  ip         String
  method     String
  path       String
  statusCode Int
  bytesSent  Int
  userAgent  String
  referrer   String?
  lineNumber Int

  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId String

  anomalies Anomaly[]

  @@index([uploadId])
  @@index([ip])
  @@index([timestamp])
}

enum AnomalySource {
  STATISTICAL
  LLM
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Anomaly {
  id            Int             @id @default(autoincrement())
  category      String
  description   String
  confidence    Float
  severity      AnomalySeverity
  source        AnomalySource
  ip            String?
  windowStart   DateTime?
  windowEnd     DateTime?
  createdAt     DateTime        @default(now())

  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId String

  events LogEvent[]

  @@index([uploadId])
}
